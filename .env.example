# Praxia — variáveis de ambiente
# Copie este arquivo para .env.local e preencha com os valores reais.
# .env.local é git-ignored (nunca commitado). Em produção, configure no dashboard da Vercel.

# ── Frontend (Vite — expostas ao browser via import.meta.env; use SÓ valores públicos) ──
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# VITE_SENTRY_DSN=                       # opcional — telemetria (no-op até configurar Sentry)

# ── Backend (Vercel serverless — server-side apenas; NUNCA prefixar com VITE_) ──
NVIDIA_API_KEY=                          # NVIDIA NIM — https://build.nvidia.com
GROQ_API_KEY=                            # Groq free tier — https://console.groq.com (modelo padrão: qwen/qwen3-32b)
CEREBRAS_API_KEY=                        # Cerebras free tier (1M tokens/dia) — https://cloud.cerebras.ai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=groq                         # nvidia | groq | cerebras | openai | anthropic | gemini
# Modelo por provedor (opcional — sobrescreve o default do código):
# GROQ_MODEL=qwen/qwen3-32b
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# CEREBRAS_MODEL=gpt-oss-120b
# Se o provedor escolhido falhar (401/429/5xx), /api/ai tenta automaticamente
# os demais provedores que tiverem chave configurada (ordem: nvidia, groq,
# cerebras, openai, anthropic, gemini).
# PRAXIA_ALLOWED_ORIGINS=                # CSV de origens p/ CORS (default: localhost dev)

# Supabase service role — usado pelos endpoints admin (delete-account, etc.).
# NUNCA expor no client (sem prefixo VITE_). Pega em
# Supabase Dashboard > Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=https://your-project-ref.supabase.co

# QDRANT_API_KEY=                        # vector store externo (não usado pelo código hoje)

# ── Mercado Pago (Sub-entrega 1.6 — billing) ──
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
