# Praxia — variáveis de ambiente
# Copie este arquivo para .env.local e preencha com os valores reais.
# .env.local é git-ignored (nunca commitado). Em produção, configure no dashboard da Vercel.

# ── Frontend (Vite — expostas ao browser via import.meta.env; use SÓ valores públicos) ──
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# VITE_SENTRY_DSN=                       # opcional — DSN do Sentry (client). Vazio = no-op (só console). Preenchido = carrega @sentry/react e reporta erros.
# VITE_BILLING_ENABLED=                  # "true" mostra UI de plano/paywall (espelha BILLING_ENABLED do server)

# ── Backend (Vercel serverless — server-side apenas; NUNCA prefixar com VITE_) ──
OPENROUTER_API_KEY=                      # default; OpenRouter tem modelos free (sujeitos a throttling em pico; status free pode mudar)
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free   # primário (default no código). Fortes free: qwen/qwen3-next-80b-a3b-instruct:free, openai/gpt-oss-120b:free, nvidia/nemotron-3-super-120b-a12b:free, moonshotai/kimi-k2.6:free
# OPENROUTER_FALLBACKS=                  # opcional; CSV de modelos free p/ fallback (default: qwen3-80b + gpt-oss-120b). Máx 3 no total.
# OPENROUTER_REFERER=                    # opcional; URL do app p/ ranking no OpenRouter
# Dica free tier: 429 em todos os modelos free? Mantenha ~US$10 de saldo na conta
# OpenRouter (não gasta) → limite free sobe de ~50 p/ ~1000 req/dia.
GROQ_API_KEY=                            # Groq tem free tier (generoso e rápido)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=                          # Google AI Studio (free tier generoso ~1500/dia). Chave começa com "AIza..."
GEMINI_MODEL=gemini-2.0-flash            # opcional; suba p/ gemini-2.5-flash p/ mais qualidade
# Roteamento BALANCEADO (round-robin) entre os free com chave: groq + gemini +
# openrouter. Cada chamada começa por um provider diferente e cai pro próximo em
# 429 — triplica a quota free efetiva. AI_PROVIDER abaixo não fixa mais a rota.
AI_PROVIDER=gemini                       # legado/hint; o balancer distribui entre os 3 free
# PRAXIA_ALLOWED_ORIGINS=                # CSV de origens p/ CORS (default: localhost dev)

# Supabase service role — usado pelos endpoints admin (delete-account, etc.).
# NUNCA expor no client (sem prefixo VITE_). Pega em
# Supabase Dashboard > Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=https://your-project-ref.supabase.co

# SENTRY_DSN=                            # opcional — DSN do Sentry (backend). Vazio = console.error sanitizado. Preenchido = @sentry/node lazy nos handlers.

# QDRANT_API_KEY=                        # vector store externo (não usado pelo código hoje)

# ── Cache semântico do chat (recicla resposta por paráfrase) ──
# Dormente por padrão. Pré-requisitos pra ligar: rodar migration 004_semantic_cache.sql
# (pgvector) + deploy da Edge Function `embed` (supabase functions deploy embed).
# SEMANTIC_CACHE_ENABLED=                 # "true" liga o cache semântico (L3) no chat
# SEMANTIC_THRESHOLD=0.92                 # similaridade mínima (0–1) p/ reusar resposta; calibrar no ar

# ── Mercado Pago (Sub-entrega 1.6 — billing) ──
# Gate de cobrança. Ausente/"" = billing DORMENTE (app grátis e ilimitado; gate
# server-side é no-op, nenhum paywall aparece). "true" = cobrança real.
# BILLING_ENABLED=
# Access token (secret server-side). Aceita MERCADO_PAGO_ACCESS_TOKEN ou MP_ACCESS_TOKEN.
# ⚠️ Token APP_USR-... é de PRODUÇÃO (cobra de verdade); TEST-... é sandbox.
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_PUBLIC_TOKEN=             # public key (não usado server-side hoje; reservado)
# MERCADO_PAGO_WEBHOOK_SECRET=           # gerado ao registrar a webhook URL no painel MP
# PUBLIC_URL=https://praxia.vercel.app   # base p/ back_url do checkout (fallback = host da request)
